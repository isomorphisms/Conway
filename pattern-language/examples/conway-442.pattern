# Conway orbifold shorthand plus an ordinary editable motif.
# *442 is the square reflection group p4m.
canvas 720 720
viewport -360 -360 360 360
background #f8f6ee
stroke #252a2e 2

motif seed
    move 8 8
    line 34 8
    arc_left 13 90
    line 21 34
    circle 15 15 3
end

orbifold *442 84
orbit seed
