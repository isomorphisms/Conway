module Example.ConwayWallpaper

import Data.Vect
import Shader

%default total

public export
wallpaper : (SVec 2 Double, SVec 2 Double, SDouble) -> SVec 4 Double
wallpaper (uv, pan, aspect) =
  let
    world : SVec 2 Double
    world = [index 0 uv * aspect * 2.0 + index 0 pan,
             index 1 uv * 2.0 + index 1 pan]

    cell = fract world
    x = index 0 cell - 0.5
    y = index 1 cell - 0.5
    radius = sqrt (x * x + y * y)
    disc = 1.0 - step 0.34 radius
    diagonal = 0.5 + 0.5 * sin ((index 0 world + index 1 world) * 3.14159265359)

    r = 0.08 + disc * (0.72 + 0.12 * diagonal)
    g = 0.12 + disc * (0.32 + 0.10 * diagonal)
    b = 0.20 + (1.0 - disc) * (0.34 + 0.10 * diagonal)
  in [r, g, b, 1.0]

public export
main : (SVec 2 Double, SVec 2 Double, SDouble) -> SVec 4 Double
main = wallpaper
